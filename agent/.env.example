# Copy this file to agent/.env and fill it in.  agent/.env is git-ignored.
# Real environment variables take precedence over values set here.

# =============================================================================
#  The easy way: pick a preset
# =============================================================================
# One name configures the provider, the chat model and the endpoint. Run
# `/models` in the REPL to list them:
#
#   mistral         Mistral API — Large 4 "Le Chonk" (default) needs MISTRAL_API_KEY
#   mistral-large-3 Mistral API — Large 3 (cheaper)            needs MISTRAL_API_KEY
#   mistral-small   Mistral API — small (cheapest)             needs MISTRAL_API_KEY
#   claude          Claude API — Opus 5                        needs ANTHROPIC_API_KEY
#   claude-sonnet   Claude API — Sonnet 5                      needs ANTHROPIC_API_KEY
#   claude-haiku    Claude API — Haiku 4.5                     needs ANTHROPIC_API_KEY
#   openai          OpenAI API — GPT-4o                        needs OPENAI_API_KEY
#   openai-mini     OpenAI API — GPT-4o mini                   needs OPENAI_API_KEY
#   local           Local Ollama — Qwen2.5 7B                  no key needed
#   local-3b        Local Ollama — Qwen2.5 3B                  no key needed
#
# This is only the DEFAULT: --model, /model, or simply asking the agent to switch
# ("use Claude", "switch to the local model") overrides it at any time.
# Unset, the agent uses "mistral" (mistral-large-4, "Le Chonk").
#FGM_MODEL=mistral

# --- API keys (only the provider you use needs one) --------------------------
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# =============================================================================
#  Manual configuration (optional — overrides the preset's individual fields)
# =============================================================================
# FGM_PROVIDER is "mistral", "anthropic", or "openai". The "openai" provider is
# also how you reach ANY OpenAI-compatible server (Ollama, vLLM, LM Studio):
# set FGM_BASE_URL and no key is needed.
#FGM_PROVIDER=openai
#FGM_BASE_URL=http://localhost:11434/v1
#FGM_CHAT_MODEL=qwen2.5-7b-16k

# --- Embeddings --------------------------------------------------------------
# Embeddings are configured separately from chat, for two reasons: the Anthropic
# API has no embeddings endpoint (so Claude borrows one), and holding the
# embedding model steady means switching chat models never rebuilds the index.
# Leave these unset and the agent reuses whatever the existing index was built
# with, falling back to the preset's embedder.
#FGM_EMBED_PROVIDER=openai
#FGM_EMBED_BASE_URL=http://localhost:11434/v1
#FGM_EMBED_MODEL=nomic-embed-text

# --- Tuning (optional; defaults shown) ---------------------------------------
FGM_TOP_K=6
FGM_TEMPERATURE=0.2
#FGM_SHOW_TOOLS=true
# on = guards act; shadow = guards only log what they would have done (evals)
#FGM_GUARDS=on
#FGM_PHYSICAL_CORES=auto
