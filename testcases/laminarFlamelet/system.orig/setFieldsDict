FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue Yc   INITIALPROGRESSVARIABLE
    //volVectorFieldValue U    (0.0 0.0 0.0)
);

regions
(
    boxToCell
    {
        box (1.5e-2 -1.0 -1.0) (5.0e-2 1.0 1.0) ;
        fieldValues
        (
            volScalarFieldValue Yc  FINALPROGRESSVARIABLE
            //volVectorFieldValue U   (2.43 0.0 0.0)
        );
    }
);

