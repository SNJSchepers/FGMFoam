FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform INLETTEMPERATURE; 

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform INLETTEMPERATURE;
    }
    outlet
    {
        type            zeroGradient;
    }
    plate
    {
        type            fixedValue;
        value           uniform PLATETEMPERATURE;
    }
    symm_top
    {
        type            symmetry;
    }
    symm_bottom
    {
        type            symmetry;
    }
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
}


